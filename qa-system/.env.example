# Copy to `.env` and fill in. `.env` is gitignored.
#
# The QA system reuses Part 2's Trupeer credentials and session. Set those in
# `part2/.env` and run `npm run auth` there once. This file only adds the model
# keys and the system's own knobs.

# --- Models -------------------------------------------------------------------
# Strong model: judgment, regression root-cause triage, fix-intent. Required for
# the AI-augmented parts; the ledger and report run without it.
ANTHROPIC_API_KEY=
STRONG_MODEL=claude-opus-5

# Cheap vision model: screenshot description and layout sanity. Optional. When
# absent, the router falls back to the strong model for vision and logs that it
# did so, at higher cost.
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash

# --- Run control --------------------------------------------------------------
# Public URL used for the read-only security probes (no login needed).
TARGET_URL=https://app.trupeer.ai

# Open the HTML report automatically when a run finishes.
OPEN_REPORT=1

# Watch the browser during a run.
HEADED=0
