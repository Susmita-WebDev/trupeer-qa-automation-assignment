# Copy to `.env` and fill in. `.env` is gitignored.
#
# Part 3 reuses Part 2's page objects, and therefore Part 2's env vars too.
# Set them in `part2/.env` — this file only adds what the judge needs.

# --- LLM judge ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# The model that grades each rewrite. Judging is a reasoning task, so a capable
# model is worth the cost — a weak judge is worse than no judge.
JUDGE_MODEL=claude-opus-5

# Reasoning depth for the judge: low | medium | high | xhigh | max
JUDGE_EFFORT=high

# --- Run control --------------------------------------------------------------
# Confidence at or above which a criterion's verdict is treated as decisive.
# Below this the result is reported as NEEDS REVIEW rather than pass or fail.
CONFIDENCE_THRESHOLD=0.75

# Where the run's JSON and Markdown reports are written.
RESULTS_DIR=results

# Set to 1 to watch the browser drive Trupeer.
HEADED=0
