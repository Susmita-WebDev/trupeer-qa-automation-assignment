# Copy to `.env` and fill in. `.env` is gitignored.
#
# Part 3 reuses Part 2's page objects, and therefore Part 2's env vars too.
# Set them in `part2/.env` - this file only adds what the judge needs.

# --- LLM judge ----------------------------------------------------------------
# The judge needs at least ONE of these keys. It tries providers in order and
# uses the first that works, so if one provider is unavailable it falls back to
# the other.
#
# GEMINI_API_KEY is free: get one at https://aistudio.google.com/app/apikey
# ANTHROPIC_API_KEY needs a small credit balance.
#
# With only GEMINI_API_KEY set, the judge uses Gemini (free). With both set, the
# anthropic provider is preferred and Gemini is the fallback. Set
# JUDGE_PROVIDER=gemini|anthropic to force one.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# JUDGE_PROVIDER=          # optional: gemini | anthropic (forces the primary)

# Models per provider. Judging is a reasoning task, so a capable model is worth
# it - a weak judge is worse than no judge.
JUDGE_MODEL=claude-opus-5
GEMINI_MODEL=gemini-2.5-flash

# Reasoning depth (anthropic provider only): low | medium | high | xhigh | max
JUDGE_EFFORT=high

# --- Run control --------------------------------------------------------------
# Confidence at or above which a criterion's verdict is treated as decisive.
# Below this the result is reported as NEEDS REVIEW rather than pass or fail.
CONFIDENCE_THRESHOLD=0.75

# Where the run's JSON and Markdown reports are written.
RESULTS_DIR=results

# Set to 1 to watch the browser drive Trupeer.
HEADED=0
