# Copy to `.env` and fill in. `.env` is gitignored - never commit real credentials.

# Base URL of the Trupeer app under test.
TRUPEER_BASE_URL=https://app.trupeer.ai

# --- Authentication -----------------------------------------------------------
# AUTH_MODE=password  -> the suite types these into the sign-in form itself.
# AUTH_MODE=manual    -> `npm run auth` opens a headed browser; you sign in by
#                        hand (Google SSO, magic link, OTP...) and the session is
#                        saved. Credentials below are then unused.
AUTH_MODE=manual

TRUPEER_EMAIL=
TRUPEER_PASSWORD=

# Where the captured browser session is stored. Gitignored.
STORAGE_STATE_PATH=.auth/user.json

# --- Test data ----------------------------------------------------------------
# Title of the video (recorded in Part 1) that the editor tests open.
# Leave blank to use whichever video appears first on the dashboard.
TRUPEER_VIDEO_NAME=

# --- Tuning -------------------------------------------------------------------
# How long to wait for the "Modify Script with AI" response, in milliseconds.
# The feature calls an LLM, so it is slower than normal UI interactions.
AI_RESPONSE_TIMEOUT_MS=120000

# Set to 1 to watch the browser while tests run.
HEADED=0
