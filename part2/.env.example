# Copy to `.env` and fill in. `.env` is gitignored.
# Never put real credentials in this file: `.env.example` is committed to git.
# The test account credentials are provided separately with the submission.

# Base URL of the Trupeer app under test.
TRUPEER_BASE_URL=https://app.trupeer.ai

# --- Authentication -----------------------------------------------------------
# AUTH_MODE=password  -> the setup logs in through the sign-in form using the
#                        email/password below (clone-and-run, single command).
# AUTH_MODE=manual    -> for Google SSO / magic-link accounts. Run `npm run auth`
#                        once to sign in by hand; the session is then reused.
AUTH_MODE=password

TRUPEER_EMAIL=
TRUPEER_PASSWORD=

# Where the captured browser session is stored. Gitignored.
STORAGE_STATE_PATH=.auth/user.json

# --- Test data ----------------------------------------------------------------
# Title of the video (recorded in Part 1) that the editor tests open.
# Leave blank to use whichever video appears first on the dashboard.
TRUPEER_VIDEO_NAME=

# --- Tuning -------------------------------------------------------------------
# How long to wait for the "Modify Script with AI" response, in milliseconds.
# The feature calls an LLM, so it is slower than normal UI interactions.
AI_RESPONSE_TIMEOUT_MS=120000

# Set to 1 to watch the browser while tests run.
HEADED=0
