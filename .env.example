# Copy this file to `.env` in the repo root and fill it in. `.env` is gitignored.
# This single file configures BOTH Part 2 (E2E suite) and Part 3 (AI validation).
#
#   cp .env.example .env
#
# --- Trupeer account (used by Part 2 and Part 3) ------------------------------
TRUPEER_EMAIL=
TRUPEER_PASSWORD=
# The video recorded in Part 1 that the editor tests open. Blank = first video.
TRUPEER_VIDEO_NAME=Antester Quick Start Guide
TRUPEER_BASE_URL=https://app.trupeer.ai
# password = the suite signs in with the email/password above (headless is blocked
#            by Trupeer, so the first sign-in opens a browser once).
# manual   = run `npm run auth` in part2/ and sign in by hand once.
AUTH_MODE=password

# --- Part 3 LLM judge ---------------------------------------------------------
# The judge needs at least ONE key. Gemini is free and enough on its own:
# https://aistudio.google.com/app/apikey . ANTHROPIC_API_KEY needs a small balance.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# JUDGE_PROVIDER=            # optional: gemini | anthropic (otherwise auto)
JUDGE_MODEL=claude-opus-5
GEMINI_MODEL=gemini-2.5-flash
JUDGE_EFFORT=high            # anthropic only: low | medium | high | xhigh | max
CONFIDENCE_THRESHOLD=0.75

# --- qa-system (bonus) --------------------------------------------------------
# Reuses the keys above. `npm run demo` needs nothing; a full run uses the keys.
# TARGET_URL=https://app.trupeer.ai
# STRONG_MODEL=claude-opus-5
# VISION_MODEL=gemini-2.5-flash

# --- Run control --------------------------------------------------------------
HEADED=0                     # 1 to watch the browser drive Trupeer (all parts)
# RESULTS_DIR=results        # where Part 3 writes its reports
# AI_RESPONSE_TIMEOUT_MS=120000
